%% Dashed outlines = future scope behind feature flags (docs/future-scope/design.md). Not yet deployed.
flowchart TB
    User([Migrant Worker - Any Language, Any Device])

    subgraph FE[FRONTEND - Firebase Hosting - React PWA]
        Landing[Landing Page + Language Selector]
        Auth[Firebase Auth - Google + Phone OTP]
        Home[Dashboard - 4 Feature Cards + 2 Flag-Gated]
    end

    User --> Landing
    Landing --> Auth
    Auth --> Home

    Home --> P1[Remittance X-Ray]
    Home --> P2[Contract Shield]
    Home --> P3[Exploitation Radar]
    Home --> P4[Financial Identity]
    Home -.flag coach.-> P5[Financial Coach]
    Home -.flag scam.-> P6[Scam Analyzer]

    subgraph BE[BACKEND - Cloud Run - FastAPI]
        API[REST API Gateway - Firebase Auth Verify]
        Router{Route to Service}
        FLG[Feature Flag Check - require_flag, 60 s cache]
        RED[PII Redaction - before log or store]
    end

    P1 --> API
    P2 --> API
    P3 --> API
    P4 --> API
    P5 --> API
    P6 --> API
    API --> Router
    Router -.v2 routes.-> FLG

    Router --> RX[Remittance Engine]
    Router --> CS[Contract Analysis Pipeline]
    Router --> RD[Radar Aggregation]
    Router --> FI[Financial Profile Builder]
    FLG --> CO[Coach Engine - SSE interview + plan]
    FLG --> SA[Scam Analysis Pipeline]
    CO --> RED
    SA --> RED

    subgraph AI[GEMINI AI LAYER]
        G1[Gemini 1.5 Flash - Vision + Extraction]
        G2[Gemini 2.5 Flash - Legal Reasoning + Synthesis]
        G3[Gemini Flash-Lite - Translation + Classification]
        G4[Embeddings - Vector Search]
    end

    RX --> G3
    CS --> G1
    CS --> G2
    RD --> G3
    RD --> G4
    FI --> G1
    FI --> G2
    CO --> G2
    CO --> G3
    SA --> G1
    SA --> G2
    SA --> G3
    SA --> G4

    subgraph DB[FIRESTORE - Data Layer]
        FS1[(users + contracts + transfers)]
        FS2[(labor_laws - 6 countries)]
        FS3[(corridors - World Bank)]
        FS4[(rates_cache + rates_history)]
        FS5[(radar_reports + radar_entities + report_embeddings)]
        FS6[(financial_profile)]
        FS7[(users coach_sessions + coach_plans)]
        FS8[(users scam_checks)]
        FS9[(scam_taxonomy + scam_patterns - vector)]
        FS10[(cost_baselines)]
        FS11[(config feature_flags)]
    end

    RX --> FS3
    RX --> FS4
    CS --> FS1
    CS --> FS2
    RD --> FS5
    FI --> FS1
    FI --> FS6

    CO --> FS7
    CO --> FS10
    CO --> FS2
    CO --> FS4
    CO -.cheapest provider.-> RX
    CO -.salary prefill.-> FS1
    CO -.plan goals.-> FS6
    SA --> FS8
    SA --> FS9
    SA --> FS5
    SA -.one-tap report.-> FS5
    FLG --> FS11

    CS --> CST[(Cloud Storage - PDFs + Reports)]
    CO --> CST

    subgraph EXT[EXTERNAL DATA SOURCES]
        WB[World Bank RPW - Quarterly Excel]
        ILO[ILO NATLEX - Labor Laws]
        FRA[Frankfurter API - Live FX]
    end

    CRON[Cloud Scheduler - Every 2 Hours]
    CRON --> FRA
    FRA --> FS4

    CRON2[Cloud Scheduler - Daily Check-In Job]
    CRON2 --> CO
    CO --> FCM[Firebase Cloud Messaging]
    FCM --> User

    WB -.One-time load.-> FS3
    ILO -.Manual curation.-> FS2

