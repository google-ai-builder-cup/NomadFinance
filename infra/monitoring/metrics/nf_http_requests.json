{
  "description": "API requests, one per request_completed line, by feature and status class (2xx, 4xx, 5xx). NF-F0-016.",
  "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"nomadfinance-api\" AND jsonPayload.message=~\"^request_completed \"",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "INT64",
    "unit": "1",
    "labels": [
      {
        "key": "feature",
        "valueType": "STRING",
        "description": "contract, remittance, radar, fib, coach, scam or platform"
      },
      {
        "key": "status_class",
        "valueType": "STRING",
        "description": "2xx, 4xx or 5xx"
      }
    ]
  },
  "labelExtractors": {
    "feature": "EXTRACT(jsonPayload.feature)",
    "status_class": "EXTRACT(jsonPayload.status_class)"
  }
}
