# Copy to .env.local for local development. Never commit real values.
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Firebase Admin SDK project. Local dev typically points this at a demo project used
# with the Firebase Emulator Suite rather than nomadfinance-prod.
FIREBASE_PROJECT_ID=nomadfinance-prod

# Required. Get the value from Secret Manager (`gemini-api-key`) or AI Studio.
GEMINI_API_KEY=
# Optional overrides; defaults live in app/config.py.
# GEMINI_MODEL_REASONING=gemini-3.5-flash
# GEMINI_MODEL_EXTRACTION=gemini-3.5-flash-lite
# GEMINI_MODEL_CLASSIFICATION=gemini-3.1-flash-lite
# GEMINI_MODEL_EMBEDDING=gemini-embedding-001
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_ATTEMPTS=3
# GEMINI_CHAT_HISTORY_TURNS=24
# GEMINI_CHAT_HISTORY_TOKENS=6000
# Tier and thinking budget of the Financial Coach's streamed reply (NF-FC-009), see D-115.
# GEMINI_COACH_REPLY_TIER=classification
# GEMINI_COACH_REPLY_THINKING_BUDGET=0
# Tier and thinking budget of slot extraction (NF-FC-010): one structured read of each message.
# GEMINI_COACH_EXTRACT_TIER=classification
# GEMINI_COACH_EXTRACT_THINKING_BUDGET=0
# Tier and thinking budget of the guardrail's scope check (NF-FC-013), for messages the rules cannot judge.
# GEMINI_COACH_GUARD_TIER=classification
# GEMINI_COACH_GUARD_THINKING_BUDGET=0
# GEMINI_COACH_PLAN_TIER=reasoning
# GEMINI_COACH_PLAN_THINKING_BUDGET=1024
# GEMINI_COACH_TRANSLATE_TIER=classification
# GEMINI_COACH_TRANSLATE_THINKING_BUDGET=0
# Per-attempt timeout for PDF contract extraction (about 2.6 s per page), NF-P2-001.
# GEMINI_EXTRACTION_TIMEOUT_SECONDS=90
# Per-attempt timeout for the clause comparison (20 to 33 s measured), NF-P2-004.
# GEMINI_COMPARE_TIMEOUT_SECONDS=90
# Per-attempt timeout for the Financial Identity narrative (21 to 40 s measured), NF-P3-013.
# GEMINI_NARRATIVE_TIMEOUT_SECONDS=90

# Cloud Scheduler auth for /api/v1/internal/*. Required when APP_ENV is staging or prod;
# leave unset locally (internal endpoints then answer 503).
# CRON_SERVICE_ACCOUNT=nomadfinance-scheduler@nomadfinance-prod.iam.gserviceaccount.com
# CRON_AUDIENCE=https://<cloud-run-service-url>

# FX providers (ADR-006). Optional: without a key that provider is skipped.
# FX_TIMEOUT_SECONDS=10
CURRENCYFREAKS_API_KEY=
WISE_API_TOKEN=

# Deleting an account (NF-P1-023). Both are optional; these are the defaults.
# Storage bucket holding users' files (contracts/, bills/, exports/ folders per user id).
FIREBASE_STORAGE_BUCKET=nomadfinance-prod.firebasestorage.app
# How recent (seconds) a person's sign-in must be for DELETE /api/v1/users/me.
ACCOUNT_DELETION_MAX_LOGIN_AGE_SECONDS=300

# Required. HMAC key for radar_reports.reporter_hash (NF-P3-001). Local: any random string.
# Prod: Secret Manager `radar-reporter-hash-secret`.
RADAR_REPORTER_HASH_SECRET=

# Largest upload in bytes (default 10 MB). Requests over this plus 64 KB get 413 before
# their body is read.
# UPLOAD_MAX_BYTES=10485760

# CORS (NF-P1-027). Leave unset: local allows the Vite dev and preview servers (5173, 4173),
# prod allows the Firebase Hosting sites. Override with a JSON list of origins.
# CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Rate limits per user and address (or per address without a token), in the `limits` notation.
# Defaults shown.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=60/minute
# Endpoints that call Gemini (they share one free-tier quota).
# RATE_LIMIT_AI=10/minute
# New scam checks that call Gemini, per signed-in worker (a repeated message is free, NF-SA-012):
# RATE_LIMIT_SCAM_ANALYZE=20/hour

# How long a Financial Identity PDF download link works, in minutes (NF-P3-014).
# EXPORT_URL_EXPIRY_MINUTES=1440

# Anti-abuse for POST /radar/report (NF-P3-025). Off by default: turn on only once the
# frontend has a real reCAPTCHA v3 site key wired through for a deployed domain, or every
# real submission gets rejected along with the bots. See that task's runbook, "Before this
# works in production."
# APP_CHECK_ENABLED=false
