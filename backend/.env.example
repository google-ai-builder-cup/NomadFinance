# Copy to .env.local for local development. Never commit real values.
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Firebase Admin SDK project. Local dev typically points this at a demo project used
# with the Firebase Emulator Suite rather than nomadfinance-prod.
FIREBASE_PROJECT_ID=nomadfinance-prod

# Required. Get the value from Secret Manager (`gemini-api-key`) or AI Studio.
GEMINI_API_KEY=
# Optional overrides; defaults live in app/config.py.
# GEMINI_MODEL_REASONING=gemini-3.5-flash
# GEMINI_MODEL_EXTRACTION=gemini-3.5-flash-lite
# GEMINI_MODEL_CLASSIFICATION=gemini-3.1-flash-lite
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_ATTEMPTS=3

# Cloud Scheduler auth for /api/v1/internal/*. Required when APP_ENV is staging or prod;
# leave unset locally (internal endpoints then answer 503).
# CRON_SERVICE_ACCOUNT=nomadfinance-scheduler@nomadfinance-prod.iam.gserviceaccount.com
# CRON_AUDIENCE=https://<cloud-run-service-url>

# FX providers (ADR-006). Optional: without a key that provider is skipped.
# FX_TIMEOUT_SECONDS=10
CURRENCYFREAKS_API_KEY=
WISE_API_TOKEN=

# Deleting an account (NF-P1-023). Both are optional; these are the defaults.
# Storage bucket holding users' files (contracts/, bills/, exports/ folders per user id).
FIREBASE_STORAGE_BUCKET=nomadfinance-prod.firebasestorage.app
# How recent (seconds) a person's sign-in must be for DELETE /api/v1/users/me.
ACCOUNT_DELETION_MAX_LOGIN_AGE_SECONDS=300
