# Loaded by `pnpm dev --mode emulator`; overrides .env.local.
# Demo values only: the Auth Emulator accepts any config for a `demo-` project,
# and nothing here reaches real Firebase.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-nomadfinance.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-nomadfinance
VITE_FIREBASE_APP_ID=demo-app-id
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_PORT=8085
