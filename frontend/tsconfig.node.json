{
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.tsbuild/node",
    "tsBuildInfoFile": "./node_modules/.tsbuild/node/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "strict": true
  },
  "include": ["vite.config.ts", "tailwind.config.ts"]
}
