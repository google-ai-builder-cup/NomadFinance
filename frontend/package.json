{
  "name": "nomadfinance-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-nomadfinance \"vitest run --no-file-parallelism tests/rules\""
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.103.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "12.19.0",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.48.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-dropzone": "20.1.2",
    "react-i18next": "17.0.15",
    "react-leaflet": "4.2.1",
    "react-leaflet-cluster": "2.1.0",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.13.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "axe-core": "4.14.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "5.0.2",
    "autoprefixer": "10.6.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2",
    "workbox-window": "7.4.1"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "~1.13.6",
      "source-map-js": ">=1.2.2"
    }
  }
}
