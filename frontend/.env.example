# Copy to .env.local for local development.
#
# Firebase web app config: public identifiers that ship in the browser bundle, not secrets.
# Get the values with:
#   firebase apps:sdkconfig WEB --project nomadfinance-prod
VITE_FIREBASE_API_KEY=
# The app's own Hosting domain, not *.firebaseapp.com: Google sign-in's redirect fallback
# only works when the auth handler is on the same site as the app (browser storage
# partitioning). Firebase Hosting serves the handler at https://<site>/__/auth/handler.
VITE_FIREBASE_AUTH_DOMAIN=nomadfinance-prod.web.app
VITE_FIREBASE_PROJECT_ID=nomadfinance-prod
VITE_FIREBASE_APP_ID=

# true = use the local Firebase Auth Emulator instead of real Firebase Auth.
# For emulator testing, `pnpm dev --mode emulator` (reads .env.emulator) is simpler.
VITE_USE_FIREBASE_EMULATOR=false
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
