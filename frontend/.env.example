# Copy to .env.local for local development.
#
# Firebase web app config: public identifiers that ship in the browser bundle, not secrets.
# Get the values with:
#   firebase apps:sdkconfig WEB --project nomadfinance-prod
VITE_FIREBASE_API_KEY=
# The app's own Hosting domain, not *.firebaseapp.com: Google sign-in's redirect fallback
# only works when the auth handler is on the same site as the app (browser storage
# partitioning). Firebase Hosting serves the handler at https://<site>/__/auth/handler.
VITE_FIREBASE_AUTH_DOMAIN=nomadfinance-prod.web.app
VITE_FIREBASE_PROJECT_ID=nomadfinance-prod
VITE_FIREBASE_APP_ID=
# Google Analytics measurement ID (G-XXXXXXXXXX), also in the sdkconfig output above. Leave it
# unset for everyday development: no measurement ID means no analytics. Set it only to try
# events in the Firebase console's DebugView (dev builds mark their events as debug traffic).
VITE_FIREBASE_MEASUREMENT_ID=
# Push notifications (NF-P3-009). Both optional and both required together: leave either
# unset and the app silently skips requesting permission / registering a token — nothing
# else breaks. VITE_FIREBASE_MESSAGING_SENDER_ID is in the sdkconfig output above.
# VITE_FIREBASE_VAPID_KEY comes from a different place: Firebase console → Project settings
# → Cloud Messaging → Web Push certificates (generate one if none exists yet).
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# Anti-abuse for reporting on Exploitation Radar (NF-P3-025). Optional: unset means the app
# sends no App Check token at all, same as today — nothing else breaks either way, matching
# the backend's own APP_CHECK_ENABLED default of off. From Firebase console → App Check →
# register this web app with reCAPTCHA v3 → the site key it gives you (itself registered
# with a deployed domain in Google's reCAPTCHA admin console first).
VITE_FIREBASE_APPCHECK_SITE_KEY=

# true = use the local Firebase Auth Emulator instead of real Firebase Auth.
# For emulator testing, `pnpm dev --mode emulator` (reads .env.emulator) is simpler.
VITE_USE_FIREBASE_EMULATOR=false
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Address of the NomadFinance backend, for features that call it (deleting an account).
# Leave empty in development: Vite forwards /api to http://127.0.0.1:8080. A deployed site
# needs the Cloud Run URL here, and the backend must allow the site's origin (CORS, NF-P1-027).
VITE_API_BASE_URL=
