              "सहायता नंबर अपने फ़ोन में सेव कर लें।"
            ]
          },
          {
            "week": 2,
            "title": "अपना पैसा व्यवस्थित करें",
            "actions": [
              "देखें कि आपके पास ऐसा खाता है जिसमें नियोक्ता वेतन डाल सके।",
              "हर खर्च लिख लें, छोटा भी।"
            ]
          },
          {
            "week": 3,
            "title": "अपना अनुबंध समझें",
            "actions": [
              "अपना अनुबंध किसी भरोसेमंद व्यक्ति के साथ फिर से पढ़ें।",
              "अपना वेतन का दिन और वेतन से कटने वाली रकम लिख लें।"
            ]
          },
          {
            "week": 4,
            "title": "आपका पहला वेतन",
            "actions": [
              "देखें कि वेतन आपके अनुबंध से मेल खाता है।",
              "वेतन पर्ची संभालकर रखें।"
            ]
          },
          {
            "week": 5,
            "title": "घर पैसे भेजें",
            "actions": [
              "भेजने से पहले सेवाओं की तुलना करें।",
              "तय रकम भेजें और रसीद रखें।"
            ]
          },
          {
            "week": 6,
            "title": "अपना खर्च जाँचें",
            "actions": [
              "जो खर्च हुआ उसे योजना से मिलाएँ।",
              "पैसे कम पड़ें तो कोई एक खर्च घटाएँ।"
            ]
          },
          {
            "week": 7,
            "title": "लक्ष्यों पर टिके रहें",
            "actions": [
              "योजना के अनुसार हर लक्ष्य के लिए रकम अलग रखें।",
              "एक महीना मुश्किल लगे तो भी कोई लक्ष्य न छोड़ें।"
            ]
          },
          {
            "week": 8,
            "title": "आपात बचत बनाएँ",
            "actions": [
              "आपात स्थिति के लिए योजना में तय रकम अलग रखें।",
              "उसे ऐसी जगह रखें जहाँ से जल्दी निकाल सकें।"
            ]
          },
          {
            "week": 9,
            "title": "फिर घर पैसे भेजें",
            "actions": [
              "सेवाओं की फिर तुलना करें, क्योंकि दाम बदलते रहते हैं।",
              "हर रसीद रखें।"
            ]
          },
          {
            "week": 10,
            "title": "अपने कागज़ात जाँचें",
            "actions": [
              "अपने दस्तावेज़ों की प्रतियाँ बनाकर सुरक्षित रखें।",
              "देखें कि आपका परमिट और पासपोर्ट कब खत्म होते हैं।"
            ]
          },
          {
            "week": 11,
            "title": "किसी भरोसेमंद से बात करें",
            "actions": [
              "वेतन या काम वादे के अनुसार न हो तो जल्दी किसी मज़दूर सहायता संगठन से बात करें।",
              "समस्या बड़ी होने तक इंतज़ार न करें।"
            ]
          },
          {
            "week": 12,
